# Modèle de production public. Ne jamais placer de vraie clé dans ce fichier.
# scripts/bootstrap-vps-env.sh remplace uniquement les trois marqueurs internes.

API_ENVIRONMENT=production

APP_DOMAIN=omnelyo.kgslab.com
API_DOMAIN=api-omnelyo.kgslab.com
BOT_DOMAIN=bot-omnelyo.kgslab.com
WEB_APP_URL=https://omnelyo.kgslab.com
FRONTEND_ORIGINS=https://omnelyo.kgslab.com
SOCIAL_OAUTH_CALLBACK_BASE_URL=https://api-omnelyo.kgslab.com

POSTGRES_DB=omnelyo
POSTGRES_USER=omnelyo
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
API_DATABASE_URL=postgresql+psycopg://omnelyo:__POSTGRES_PASSWORD__@postgres:5432/omnelyo

REDIS_PASSWORD=__REDIS_PASSWORD__
REDIS_URL=redis://:__REDIS_PASSWORD__@redis:6379/0

API_JWT_SECRET=__API_JWT_SECRET__
API_ACCESS_TOKEN_MINUTES=15
API_REFRESH_TOKEN_DAYS=30
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT_PER_HOUR=5
EXPOSE_DEV_OTP=false
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=120

# À renseigner manuellement sur le VPS après le premier bootstrap.
EMAIL_PROVIDER=resend
EMAIL_FROM=Omnelyo <onboarding@resend.dev>
EMAIL_REPLY_TO=
RESEND_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_LINK_TTL_SECONDS=600

BILLING_ENABLED=false
BILLING_DEFAULT_PROVIDER=dodo
DODO_ENVIRONMENT=test
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_RETURN_URL=https://omnelyo.kgslab.com/settings/billing

MONEYFUSION_API_KEY_URL=
MONEYFUSION_RETURN_URL=https://omnelyo.kgslab.com/settings/billing
MONEYFUSION_WEBHOOK_URL=https://api-omnelyo.kgslab.com/v1/billing/webhooks/moneyfusion

TIKTOK_SANDBOX_MODE=true
JOB_WORKER_CONCURRENCY=1
JOB_POLL_INTERVAL_SEC=2
JOB_MAX_ATTEMPTS=2

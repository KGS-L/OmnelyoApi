# Copier vers /etc/nginx/sites-available/shortpilot puis remplacer les 3 domaines.
# Exécuter Certbot après avoir activé le site et vérifié que les DNS pointent vers le VPS.

map $http_upgrade $shortpilot_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name app.example.com;

    location / {
        proxy_pass http://127.0.0.1:3000;
        include proxy_params;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $shortpilot_connection_upgrade;
        proxy_read_timeout 60s;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name api.example.com;

    client_max_body_size 550M;

    location / {
        proxy_pass http://127.0.0.1:8000;
        include proxy_params;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name bot.example.com;

    location / {
        proxy_pass http://127.0.0.1:8420;
        include proxy_params;
        proxy_http_version 1.1;
        proxy_read_timeout 180s;
    }
}

map $http_upgrade $omnelyo_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __API_DOMAIN__;

    client_max_body_size 550M;
    include /etc/nginx/snippets/omnelyo-security-headers.conf;

    location / {
        proxy_pass http://127.0.0.1:8000;
        include proxy_params;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name __BOT_DOMAIN__;

    include /etc/nginx/snippets/omnelyo-security-headers.conf;

    location / {
        proxy_pass http://127.0.0.1:8420;
        include proxy_params;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $omnelyo_connection_upgrade;
        proxy_read_timeout 180s;
    }
}

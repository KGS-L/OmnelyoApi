# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- YouTube API (OAuth2 - flow Web) ---
YOUTUBE_CLIENT_SECRETS_FILE=credentials/client_secret.json
YOUTUBE_TOKEN_FILE=credentials/token.json
# Doit matcher EXACTEMENT l'URI de redirection enregistrée dans Google Cloud Console
YOUTUBE_REDIRECT_URI=https://ton-domaine-ou-ip.com/oauth2callback
OAUTH_CALLBACK_PORT=8420

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=robot-short-yt
R2_ENDPOINT_URL=

# --- LLM (storytime) — Groq ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b

# --- TTS ---
ELEVENLABS_API_KEY=

# --- Scheduling ---
PUBLISH_SLOTS=12:00,17:00,20:00
MAX_CLIPS_PER_DAY=3
CLIP_MIN_DURATION_SEC=60
CLIP_MAX_DURATION_SEC=150
TIMEZONE=Africa/Ouagadougou

# --- DB ---
DATABASE_PATH=db/robot_short_yt.sqlite3
# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_TTL_SECONDS=600

# Clé Fernet pour chiffrer les tokens OAuth sociaux en base.
# Génération : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOCIAL_CREDENTIALS_KEY=
SOCIAL_OAUTH_CALLBACK_BASE_URL=https://api.ton-domaine.com/v1/integrations/social
SOCIAL_OAUTH_STATE_TTL_SECONDS=600

# --- Workers SaaS PostgreSQL + réveil Redis ---
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_STALE_AFTER_SECONDS=300
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_RECOVERY_INTERVAL_SECONDS=60
WORKER_RETRY_DELAY_SECONDS=30

# --- YouTube API (OAuth2 - flow Web) ---
YOUTUBE_CLIENT_SECRETS_FILE=credentials/client_secret.json
YOUTUBE_TOKEN_FILE=credentials/token.json
# Doit matcher EXACTEMENT l'URI de redirection enregistrée dans Google Cloud Console
YOUTUBE_REDIRECT_URI=https://ton-domaine-ou-ip.com/oauth2callback

# --- TikTok Content Posting API (privé tant que l'application n'est pas auditée) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_SANDBOX_MODE=true

# --- Meta Graph API : Facebook Pages puis Instagram professionnel ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
OAUTH_CALLBACK_PORT=8420

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=robot-short-yt
R2_ENDPOINT_URL=
R2_SIGNED_URL_TTL_SECONDS=900

# --- LLM storytime ---
# Valeurs : openai, gemini, groq, xai (ou grok), mistral, kimi
LLM_PROVIDER=groq

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

XAI_API_KEY=
XAI_MODEL=grok-3-mini

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

KIMI_API_KEY=
KIMI_MODEL=kimi-k2.5
KIMI_BASE_URL=https://api.moonshot.ai/v1

# --- Voix storytime (OpenAI TTS) ---
TTS_PROVIDER=openai
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_TTS_INSTRUCTIONS=Parle en français avec une voix naturelle, captivante et dynamique, adaptée à une storytime.

# --- Scheduling ---
PUBLISH_SLOTS=12:00,17:00,20:00
MAX_CLIPS_PER_DAY=3
CLIP_MIN_DURATION_SEC=60
CLIP_MAX_DURATION_SEC=150
TIMEZONE=Africa/Ouagadougou

# --- Upload manuel de Shorts via Telegram ---
# La Bot API publique ne permet pas au bot de télécharger plus de 20 Mo.
TELEGRAM_UPLOAD_MAX_MB=19
UPLOADED_SHORT_MAX_DURATION_SEC=180
MANUAL_SCHEDULE_MIN_LEAD_MINUTES=15
MANUAL_SCHEDULE_MAX_DAYS=365

# --- File persistante ---
# Commencer à 1 : ffmpeg et la détection de scènes consomment beaucoup de CPU/RAM.
JOB_WORKER_CONCURRENCY=1
JOB_POLL_INTERVAL_SEC=2
JOB_MAX_ATTEMPTS=2

# --- Paiement manuel MVP ---
MANUAL_PAYMENT_INSTRUCTIONS=Effectue le paiement par Orange Money ou Moov Money, puis transmets la référence au support.

# --- Backend SaaS ---
POSTGRES_DB=robot_short_yt
POSTGRES_USER=robot
POSTGRES_PASSWORD=replace-with-a-strong-random-password
API_ENVIRONMENT=development
API_DATABASE_URL=postgresql+psycopg://robot:robot@postgres:5432/robot_short_yt
REDIS_URL=redis://redis:6379/0
API_JWT_SECRET=change-this-with-at-least-32-random-characters
API_ACCESS_TOKEN_MINUTES=15
API_REFRESH_TOKEN_DAYS=30
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT_PER_HOUR=5
EXPOSE_DEV_OTP=false
GOOGLE_WEB_CLIENT_ID=
FRONTEND_ORIGINS=http://localhost:3000
VIDEO_UPLOAD_MAX_BYTES=524288000
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=120
BOT_DOMAIN=bot.ton-domaine.com
API_DOMAIN=api.ton-domaine.com

# --- DB ---
DATABASE_PATH=db/robot_short_yt.sqlite3
